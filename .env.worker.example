# Private worker configuration. Do not copy API administrator credentials.
SAHAYAK_DB_HOST=
SAHAYAK_DB_PORT=5432
SAHAYAK_DB_NAME=sahayak
SAHAYAK_DB_USER=sahayak_dispatch
SAHAYAK_DB_PASSWORD=
SAHAYAK_DB_CA_FILE=
SAHAYAK_AWS_REGION=ap-south-1
# Optional AWS CLI profile. Use normal AWS credential chain; never keys in browser.
SAHAYAK_AWS_PROFILE=default
SAHAYAK_QUEUE_URL=
SAHAYAK_WORKER_MODE=preflight
SAHAYAK_OUTBOUND_CALLS_ENABLED=false
